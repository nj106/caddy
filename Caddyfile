{
	# Persist certs in the mounted /data volume so container recreations
	# (e.g. watchtower updates) don't trigger re-issuance every time.
	storage file_system {
		root /data
	}
}

# Host-mode container: 127.0.0.1 is the VPS itself, ports are the
# services' published host ports.

